{
  "name": "reliefconnect",
  "version": "1.0.0",
  "description": "Open-source volunteer disaster relief coordination platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:verbose": "jest --runInBand --forceExit --verbose"
  },
  "keywords": [
    "disaster-relief",
    "volunteer",
    "coordination",
    "nonprofit",
    "community"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}