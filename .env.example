# ReliefConnect Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required for AI-powered mission generation
volunteerdisasterrelief_anthropic_api_key=your_anthropic_api_key_here

# Required for email alerts (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
ALERT_FROM_EMAIL=alerts@volunteerdisasterrelief.com

# Optional: port override (default: 3000)
PORT=3000
