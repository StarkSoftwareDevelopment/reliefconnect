# ReliefConnect Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required for AI-powered mission generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: port override (default: 3000)
PORT=3000

# Optional: future email alert backend
# SENDGRID_API_KEY=
# ALERT_FROM_EMAIL=alerts@yourdomain.org
