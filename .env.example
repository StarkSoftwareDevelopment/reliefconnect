# ReliefConnect Environment Variables
# Copy to .env for local dev. Never commit .env.

# Anthropic AI
volunteerdisasterrelief_anthropic_api_key=sk-ant-...

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # Settings → API in Supabase dashboard

# SendGrid
SENDGRID_API_KEY=SG.your_key_here
ALERT_FROM_EMAIL=alerts@volunteerdisasterrelief.com

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

PORT=3000
